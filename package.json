{
  "scripts": {
    "build": "dotnet build",
    "test": "dotnet test",
    "test:deploy": "yarn deploy:local; Test-ModuleManifest pub/GFK.Image/GFK.Image.psd1",
    "test:release": "yarn semantic-release --dry-run",
    "test:all": "yarn test; yarn test:deploy; yarn test:release",
    "deploy:local": "pwsh -NoLogo -NoProfile -File .github/scripts/deploy-module.ps1",
    "deploy:user": "pwsh -NoLogo -NoProfile -File .github/scripts/deploy-module.ps1 -InstallForUser",
    "deploy:psgallery": "yarn deploy:local; Publish-Module -Path pub/GFK.Image",
    "docs:md": "yarn deploy:local; Import-Module ./pub/GFK.Image/GFK.Image.psd1; Install-Module platyPS -Force; Update-MarkdownHelp docs",
    "docs:xml": "yarn docs:md; New-ExternalHelp docs -OutputPath ./GFK.Image/en-US -Force"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "semantic-release": "^25.0.9"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "pwsh -NoLogo -NoProfile -Command \"Update-ModuleManifest -Path 'pub/GFK.Image/GFK.Image.psd1' -ModuleVersion '${nextRelease.version}'\"",
          "publishCmd": "pwsh -NoLogo -NoProfile -File '.github/scripts/publish-module.ps1'"
        }
      ]
    ]
  },
  "version": "0.0.0"
}
